# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Claude connector (server-only, never prefix with NEXT_PUBLIC_)
# Supabase → Project Settings → API → service_role / secret key
SUPABASE_SERVICE_ROLE_KEY=
# SQL: select id from families;
FAMILY_ID=
# Long random string, e.g. `openssl rand -hex 32`. Connector URL = https://<app>/api/mcp/<MCP_TOKEN>
MCP_TOKEN=
